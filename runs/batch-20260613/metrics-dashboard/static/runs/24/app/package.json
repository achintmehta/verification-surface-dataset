{
  "name": "metrics-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "cd frontend && npx vite --port 5173",
    "build:frontend": "cd frontend && npx vite build",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "@electric-sql/pglite": "^0.2.15"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.3.5"
  }
}
