{
  "name": "metrics-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node --check server/index.js && node --check src/main.js",
    "typecheck": "node --check server/index.js && node --check src/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-basic-ssl": "latest",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "vite": "^5.1.4"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
