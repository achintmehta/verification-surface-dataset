    "build": "npx vite build --config frontend/vite.config.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "concurrently": "^8.2.2",
    "vite": "^5.4.19"
  }
}
