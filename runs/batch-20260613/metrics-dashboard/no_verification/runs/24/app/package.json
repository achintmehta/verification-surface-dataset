{
  "name": "metrics-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node server/index.js",
    "dev:frontend": "npx vite client --port 5173",
    "build": "npx vite build client --outDir ../dist",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.2.15",
    "cors": "^2.8.5",
    "concurrently": "^8.2.2",
    "vite": "^5.4.19"
  }
}
