{
  "name": "week-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch server/server.js",
    "client": "vite --host 0.0.0.0",
    "start": "node server/server.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "concurrently": "latest",
    "vite": "latest"
  }
}
