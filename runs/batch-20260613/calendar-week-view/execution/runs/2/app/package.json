{
  "name": "calendar-week-view",
  "version": "1.0.0",
  "description": "Single-user week-view calendar with PGLite backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --port 5173",
    "build": "vite build client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.0.0"
  }
}
