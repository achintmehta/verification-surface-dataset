{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "globals": {
    "confirm": "readonly",
    "alert": "readonly"
  },
  "rules": {
    "no-alert": "off",
    "require-atomic-updates": "off"
  }
}
