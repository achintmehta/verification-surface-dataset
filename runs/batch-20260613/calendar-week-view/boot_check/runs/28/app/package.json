{
  "name": "week-calendar",
  "version": "1.0.0",
  "type": "module",
  "description": "Week view calendar with overlap layout",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.1.5",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
