{
  "name": "calendar-week-view",
  "version": "1.0.0",
  "description": "Single-user week-view calendar with PGLite backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite client --port 5173",
    "build": "vite build client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
