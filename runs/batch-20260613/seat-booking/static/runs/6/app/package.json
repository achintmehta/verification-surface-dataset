{
  "name": "seat-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node --check server.js && node --check src/main.js",
    "typecheck": "npm run lint"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
