{
  "env": {
    "es2020": true,
    "node": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error"
  },
  "globals": {
    "EventSource": "readonly",
    "localStorage": "readonly",
    "crypto": "readonly"
  }
}
