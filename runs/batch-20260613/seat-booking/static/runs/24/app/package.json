{
  "name": "seat-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "cd frontend && npx vite",
    "build": "cd frontend && npx vite build",
    "start": "node backend/server.js",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "@types/express": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.15.17",
    "eslint": "^9.27.0"
  }
}
