{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Seat booking / ticketing service with PGLite and SSE",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
