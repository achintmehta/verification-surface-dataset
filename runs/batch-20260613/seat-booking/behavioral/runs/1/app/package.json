{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Seat booking service with PGLite, Express, and SSE",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:server": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --testPathPattern=server"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@jest/globals": "^29.7.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "uuid": "^10.0.0"
  }
}
