{
  "name": "seat-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seat-booking / ticketing service with atomic holds, TTL expiry, idempotent confirmation, and real-time SSE updates.",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  }
}
