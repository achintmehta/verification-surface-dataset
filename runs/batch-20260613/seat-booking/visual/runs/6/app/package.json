{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Concurrent-safe seat booking demo with PGLite, Express, SSE, and Vite.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "vite": "^5.4.21"
  }
}
