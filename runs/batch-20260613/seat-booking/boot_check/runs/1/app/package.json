{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Seat booking service with PGLite, Express, and SSE",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"server,client\" --prefix-colors \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --port 5173",
    "build": "vite build client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
