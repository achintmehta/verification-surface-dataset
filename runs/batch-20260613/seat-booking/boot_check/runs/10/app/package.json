{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Concurrent-safe seat booking service with PGLite, Express, SSE, and vanilla JS UI.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  }
}
