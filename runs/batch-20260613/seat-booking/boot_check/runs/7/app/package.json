{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Concurrent-safe seat booking demo with PGLite, Express, SSE and Vite",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "vite": "^5.2.0"
  },
  "devDependencies": {}
}
