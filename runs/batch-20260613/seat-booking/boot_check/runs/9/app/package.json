{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Concurrent-correct seat booking service using Express, PGLite and SSE",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  }
}
