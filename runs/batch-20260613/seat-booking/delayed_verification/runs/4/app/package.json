{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Seat booking service with PGLite, Express, and SSE",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names \"server,client\" --prefix-colors \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
