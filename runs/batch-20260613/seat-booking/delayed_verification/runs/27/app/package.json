{
  "name": "seat-booking",
  "version": "1.0.0",
  "description": "Seat booking service with PGLite, Express, and SSE",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.1.5",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}