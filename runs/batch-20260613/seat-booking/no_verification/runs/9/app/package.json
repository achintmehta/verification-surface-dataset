{
  "name": "seat-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/server.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@vitejs/plugin-basic-ssl": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
