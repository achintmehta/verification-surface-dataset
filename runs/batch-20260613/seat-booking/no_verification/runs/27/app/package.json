    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@electric-sql/pglite": "^0.2.15",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}