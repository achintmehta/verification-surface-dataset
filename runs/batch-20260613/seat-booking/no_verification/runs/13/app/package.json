{
  "name": "seat-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Seat-booking / ticketing service with atomic holds, TTL expiry, idempotent confirmation, and SSE live updates.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
