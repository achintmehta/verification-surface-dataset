{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "description": "Realtime collaborative Kanban board using Express, PGLite, SSE, and Vite.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node --check server/index.js && node --check src/main.js && node --check vite.config.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "concurrently": "latest",
    "vite": "latest"
  }
}
