{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "node --check server/index.js && node --check src/main.js && node --check vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "@vitejs/plugin-basic-ssl": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
