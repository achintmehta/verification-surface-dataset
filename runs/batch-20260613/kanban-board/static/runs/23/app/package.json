    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "@types/express": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "@eslint/js": "^9.27.0",
    "typescript-eslint": "^8.32.1"
  }
