{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node --check server/index.js && node --check src/main.js",
    "typecheck": "node --check server/index.js && node --check src/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "latest",
    "concurrently": "latest",
    "vite": "latest"
  }
}
