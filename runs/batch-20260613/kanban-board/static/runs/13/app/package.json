{
  "name": "kanban-board",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-user collaborative Kanban board with PGLite + SSE",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "vite": "^5.4.0"
  }
}
