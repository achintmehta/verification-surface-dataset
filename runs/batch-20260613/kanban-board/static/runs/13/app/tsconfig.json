{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": []
  },
  "include": ["client/**/*.js", "server/**/*.js", "*.js"],
  "exclude": ["node_modules", "dist", "data"]
}
