{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "server:start": "node server/index.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "^8.2.2",
    "cors": "latest",
    "express": "latest"
  }
}
