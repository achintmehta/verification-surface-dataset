{
  "name": "collaborative-kanban-pglite-sse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build client",
    "preview": "vite preview client --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "vite": "5.4.14"
  }
}
