{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative Kanban board using Express, embedded PGLite, SSE, and a vanilla Vite frontend.",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite web --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build web",
    "preview": "vite preview web --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
