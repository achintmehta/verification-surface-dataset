{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server": "node server/index.js",
    "server:dev": "node server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
