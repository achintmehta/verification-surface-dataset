{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "description": "Real-time collaborative Kanban board using Express, PGLite, SSE, and Vanilla JS/Vite.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
