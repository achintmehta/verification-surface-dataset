{
  "name": "kanban-board",
  "version": "1.0.0",
  "description": "Real-time collaborative Kanban board with PGLite and SSE",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client --port 5173",
    "start": "concurrently --kill-others \"npm run start:server\" \"npm run dev:client\"",
    "start:server": "node server/index.js",
    "build": "vite build client",
    "preview": "vite preview client"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
