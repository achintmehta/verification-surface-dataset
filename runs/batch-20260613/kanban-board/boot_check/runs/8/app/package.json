{
  "name": "collaborative-kanban-board",
  "version": "1.0.0",
  "description": "Collaborative Kanban board with PGLite, Express, SSE and Vanilla JS drag-and-drop.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
