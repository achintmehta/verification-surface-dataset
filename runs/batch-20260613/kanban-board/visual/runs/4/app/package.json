{
  "name": "kanban-board",
  "version": "1.0.0",
  "description": "Real-time collaborative Kanban board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite client --port 5173",
    "build": "cd client && npx vite build --outDir ../dist",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.19"
  }
}
