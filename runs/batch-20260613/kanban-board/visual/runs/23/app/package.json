{
  "name": "kanban-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node server/index.js",
    "dev:frontend": "cd client && npx vite --port 5173",
    "build": "cd client && npx vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "@electric-sql/pglite": "^0.2.15",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "vite": "^5.4.19"
  }
}
