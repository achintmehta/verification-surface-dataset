{
  "name": "log-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High-volume log explorer with virtualized rendering and windowed query API",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "vite --config frontend/vite.config.js --host",
    "start": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
