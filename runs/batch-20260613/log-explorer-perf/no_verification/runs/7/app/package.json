{
  "name": "log-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite client --host 0.0.0.0 --port 5173",
    "dev": "concurrently -k -n server,client \"npm run server\" \"npm run client\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "vite": "latest"
  }
}
