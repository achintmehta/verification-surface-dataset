{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["server/src/**/*.ts", "client/src/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "server/.pgdata", "client/dist"]
}
