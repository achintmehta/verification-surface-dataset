{
  "name": "log-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Windowed PGLite log explorer with a virtualized vanilla JS UI.",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "dev": "node scripts/dev.js",
    "typecheck": "node --check server/index.js && node --check scripts/dev.js",
    "lint": "node --check server/index.js && node --check scripts/dev.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
