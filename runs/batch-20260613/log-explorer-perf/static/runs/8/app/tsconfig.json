{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["server/**/*.js", "scripts/**/*.js", "src/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "pglite-data", "dist", ".vite"]
}
