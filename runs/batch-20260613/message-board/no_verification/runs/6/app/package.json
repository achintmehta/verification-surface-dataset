{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight realtime message board using Express, PGLite, Server-Sent Events, and Vite.",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "vite": "latest"
  }
}
