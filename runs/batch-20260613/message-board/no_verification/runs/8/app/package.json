{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight realtime message board using Express, embedded PGLite, SSE, and Vanilla JS/Vite.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js --host 0.0.0.0",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.1.6"
  }
}
