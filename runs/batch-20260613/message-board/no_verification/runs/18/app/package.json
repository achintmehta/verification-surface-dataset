{
  "name": "message-board",
  "version": "1.0.0",
  "description": "Real-time message board with PGLite and SSE",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "vite": "latest"
  }
}