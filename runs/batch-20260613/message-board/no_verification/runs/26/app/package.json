{
  "name": "realtime-message-board",
  "version": "1.0.0",
  "description": "Real-time message board using PGLite and SSE",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "start": "node server.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}