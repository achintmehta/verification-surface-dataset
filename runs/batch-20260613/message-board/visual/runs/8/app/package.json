{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "description": "A lightweight realtime message board using Express, PGLite, SSE, and vanilla Vite.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {}
}
