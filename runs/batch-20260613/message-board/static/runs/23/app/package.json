{
  "name": "message-board",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time message board using PGLite and Server-Sent Events",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "@types/express": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.15.17",
    "eslint": "^9.27.0"
  }
}
