{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight realtime message board using Express, PGLite, SSE, and Vanilla JS/Vite.",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node --check server/index.js && node --check client/src/main.js",
    "typecheck": "node --check server/index.js && node --check client/src/main.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
