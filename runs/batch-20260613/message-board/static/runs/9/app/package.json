{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight realtime message board using Express, PGLite, SSE, and Vite.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint": "node --check server/index.js && node --check src/main.js && node --check vite.config.js",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.1.6"
  }
}
