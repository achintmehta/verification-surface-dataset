{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "node --check server/index.js && node --check vite.config.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
