{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "outDir": "./dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["server/**/*.js", "client/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
