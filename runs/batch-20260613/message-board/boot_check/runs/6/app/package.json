{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "description": "A lightweight real-time message board using Express, PGLite, SSE, and Vanilla JS/Vite.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "express": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
