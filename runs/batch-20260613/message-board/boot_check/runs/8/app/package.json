{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "description": "A lightweight real-time message board using Express, PGLite, SSE, and Vanilla JS/Vite.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "vite --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.2",
    "concurrently": "^8.2.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
