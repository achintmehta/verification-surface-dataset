{
  "name": "pglite-sse-message-board",
  "version": "1.0.0",
  "description": "A lightweight realtime message board using Express, PGLite, SSE, and Vanilla JS/Vite.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "latest",
    "cors": "latest",
    "express": "latest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.11"
  }
}
