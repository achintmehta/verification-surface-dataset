{
  "name": "message-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A real-time message board using PGLite and Server-Sent Events",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node server/index.js",
    "dev:frontend": "vite client",
    "build": "vite build client",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
